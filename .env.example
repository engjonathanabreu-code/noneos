# Required. Create separate random secrets; never prefix these with NEXT_PUBLIC_.
NONE_ACCESS_KEY=
NONE_SESSION_SECRET=
# Future integrations are intentionally disabled and have no credentials yet.
# Read-only company indicators (server only). Role none_reader can only run none_os.resumo().
# Format: postgresql://none_reader.<project-ref>:<password>@<pooler-host>:6543/postgres
NONE_DB_INTEGRAL_CRM=
NONE_DB_INTEGRAL_ERP=
NONE_DB_MCL=
NONE_DB_MATRICULAIA=
# Google Calendar OAuth (server only). Redirect URI: <origin>/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# none AI (server only): reads reports exported from company systems (e.g. Next Fit)
ANTHROPIC_API_KEY=
# none OS database (server only): schema none_os in the "Financas Pessoais Casa" project.
# Role none_app can only execute none_os.salvar_relatorio / relatorios_da_organizacao / remover_relatorio.
NONE_DB_APP=
