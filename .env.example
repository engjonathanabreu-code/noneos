# Required. Create separate random secrets; never prefix these with NEXT_PUBLIC_.
NONE_ACCESS_KEY=
NONE_SESSION_SECRET=
# Read-only company indicators (server only). Role none_reader can only run none_os.resumo().
# Format: postgresql://none_reader.<project-ref>:<password>@<pooler-host>:6543/postgres
NONE_DB_INTEGRAL_CRM=
NONE_DB_INTEGRAL_ERP=
NONE_DB_MCL=
NONE_DB_MATRICULAIA=
# Google Calendar OAuth (server only). Redirect URI: <origin>/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# none AI (server only): Perguntar à none, agents, decision analysis, BrainStorm, checklists and report reading
ANTHROPIC_API_KEY=
# none OS database (server only): schema none_os in the "Financas Pessoais Casa" project.
# Role none_app can only execute the none_os report functions and the workspace sync functions
# (estado_versoes / estado_ler / estado_salvar / estado_remover / estado_historico).
# Without it the workspace stays in each browser only.
NONE_DB_APP=
# Required only for organization-level API keys (not scoped to a workspace)
ANTHROPIC_WORKSPACE_ID=
